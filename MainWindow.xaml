<Window x:Class="clony.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:clony"
        Title="clony" Height="860" Width="1000" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <!-- No system title bar (like Picky): the header below is the title bar. Resize, snap and the
         window shadow keep working through WindowChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left navigation rail, icons only (same pattern as Wally). Tooltips give the page names. -->
    <Border Grid.Column="0" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,64,0,12">
            <RadioButton DockPanel.Dock="Bottom" x:Name="PrefsTab" Tag="&#xE713;" ToolTip="Preferences"
                         AutomationProperties.Name="Preferences" Style="{StaticResource NavButton}"
                         GroupName="pages" Checked="Tab_Checked"/>
            <StackPanel>
                <RadioButton x:Name="CloneTab" Tag="&#xE8C8;" ToolTip="Clone" AutomationProperties.Name="Clone"
                             Style="{StaticResource NavButton}" IsChecked="True" GroupName="pages" Checked="Tab_Checked"/>
                <RadioButton x:Name="VerifyTab" Tag="&#xE9D5;" ToolTip="Verify differences" AutomationProperties.Name="Verify differences"
                             Style="{StaticResource NavButton}" GroupName="pages" Checked="Tab_Checked"/>
                <RadioButton x:Name="ScanTab" Tag="&#xE80A;" ToolTip="Sector scan" AutomationProperties.Name="Sector scan"
                             Style="{StaticResource NavButton}" GroupName="pages" Checked="Tab_Checked"/>
                <RadioButton x:Name="FormatTab" Tag="&#xE75C;" ToolTip="Format" AutomationProperties.Name="Format"
                             Style="{StaticResource NavButton}" GroupName="pages" Checked="Tab_Checked"/>
                <RadioButton x:Name="PartitionsTab" Tag="&#xEDA2;" ToolTip="Partitions" AutomationProperties.Name="Partitions"
                             Style="{StaticResource NavButton}" GroupName="pages" Checked="Tab_Checked"/>
            </StackPanel>
        </DockPanel>
    </Border>

    <Grid x:Name="RootGrid" Grid.Column="1" Margin="20,12,12,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header = title bar: drag to move, double-click to maximize -->
        <Grid Grid.Row="0" Margin="0,0,8,14" Background="Transparent"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Image x:Name="HeaderLogo" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="clony" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Caption}" Text="Bit-for-bit SSD clone · the source is only ever read"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="PageTitle" Text="Clone" Style="{StaticResource Heading}" FontSize="16"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="28,8,0,0"/>
            <Button Grid.Column="2" x:Name="RefreshButton" Style="{StaticResource ToolIconButton}"
                    VerticalAlignment="Center" Margin="0,8,0,0" Click="Refresh_Click" AutomationProperties.Name="Refresh" ToolTip="Refresh - re-scan disks (also automatic when a drive is plugged in or removed)"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,-8,0">
                <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" Click="CloseWindow_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Disk list with per-disk eject -->
        <Border Grid.Row="1" x:Name="DiskCard" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
            <StackPanel>
                <TextBlock Text="CONNECTED DISKS" Style="{StaticResource SectionTitle}"/>
                <ItemsControl x:Name="DiskList" Style="{StaticResource PlainList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding EjectLabel}" Style="{StaticResource SmallButton}"
                                        IsEnabled="{Binding CanEject}" VerticalAlignment="Center" MinWidth="76"
                                        Click="Eject_Click" CommandParameter="{Binding}"
                                        ToolTip="Safely remove this disk (like the tray icon)"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ================= CLONE PAGE ================= -->
        <Grid Grid.Row="2" x:Name="ClonePage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SOURCE · read only" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="SourceCombo" DisplayMemberPath="Caption" SelectionChanged="Selection_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DESTINATION · will be completely overwritten" Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <ComboBox x:Name="DestCombo" DisplayMemberPath="Caption" SelectionChanged="Selection_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OPTIONS" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="DryRunCheck" IsChecked="True" Click="DryRun_Click" Content="Dry run - check and show the plan, write nothing"/>
                        <CheckBox x:Name="VerifyCheck" IsChecked="True" Content="Verify bit-for-bit after copying (doubles the time)"/>
                        <CheckBox x:Name="GptCheck" IsChecked="True" Content="Fix partition table so the extra space is usable"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Block size" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="BlockCombo" Width="110" SelectedIndex="2">
                                <ComboBoxItem Content="1 MB" Tag="1"/>
                                <ComboBoxItem Content="4 MB" Tag="4"/>
                                <ComboBoxItem Content="16 MB" Tag="16"/>
                                <ComboBoxItem Content="64 MB" Tag="64"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CONFIRM DESTINATION" Style="{StaticResource SectionTitle}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock x:Name="ConfirmHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="For a real clone, type the destination disk number."/>
                        <TextBox x:Name="ConfirmBox" MaxLength="3" Width="80" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CloneButton" Content="Run dry run" Style="{StaticResource AccentButton}" Click="Clone_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= VERIFY PAGE ================= -->
        <Grid Grid.Row="2" x:Name="VerifyPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ORIGINAL" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="VerifySourceCombo" DisplayMemberPath="Caption"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COPY" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="VerifyDestCombo" DisplayMemberPath="Caption"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" x:Name="SummaryCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="SummaryTitle" Text="No comparison yet" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Read-only: compares every sector of the original with the copy. Runs automatically after a clone with 'Verify' ticked."/>
                    <CheckBox x:Name="VerifyOfflineCheck" IsChecked="True" Margin="0,10,0,0"
                              Content="Lock both disks while comparing (Windows can't change them mid-check)"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RESULT" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="1" Text="WHERE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="2" Text="BYTE OFFSET" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="3" Text="SIZE" Style="{StaticResource SectionTitle}"/>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="DiffList" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Padding="4,3"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="kind" Text="{Binding Kind}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Location}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StartText}" FontFamily="Cascadia Mono, Consolas"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Expected}" Value="True">
                                        <Setter TargetName="kind" Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter TargetName="kind" Property="FontWeight" Value="Normal"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ExportButton" Content="Export report" Style="{StaticResource SubtleButton}" Margin="0,0,10,0"
                        IsEnabled="False" Click="Export_Click"/>
                <Button x:Name="VerifyButton" Content="Compare disks" Style="{StaticResource AccentButton}" Click="Verify_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= SECTOR SCAN PAGE ================= -->
        <Grid Grid.Row="2" x:Name="ScanPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DISK TO SCAN · read only" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="ScanDiskCombo" DisplayMemberPath="Caption"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="START FROM (GB)" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="ScanStartBox" Text="0" Width="90" MaxLength="6" HorizontalAlignment="Left"
                                 ToolTip="Start part-way in, e.g. to continue past an area that made the drive stop responding"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="SLOW IF A 4 MB READ TAKES OVER" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="ScanSlowCombo" Width="120" SelectedIndex="1" HorizontalAlignment="Left">
                            <ComboBoxItem Content="100 ms" Tag="100"/>
                            <ComboBoxItem Content="250 ms" Tag="250"/>
                            <ComboBoxItem Content="500 ms" Tag="500"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <local:SectorMatrix x:Name="Matrix" Margin="0,0,16,0" MinHeight="120"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ScanTitle" Text="No scan yet" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ScanText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14"
                                   Text="Reads every sector of one disk and times each read. Nothing is written. Each square is 1/2048 of the disk, start top-left."/>
                        <TextBlock Text="LEGEND" Style="{StaticResource SectionTitle}"/>
                        <StackPanel x:Name="Legend"/>
                        <TextBlock Text="UNDER THE MOUSE" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
                        <TextBlock x:Name="CellInfo" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Point at a square to see where it is on the disk."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RESULT" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="1" Text="WHERE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="2" Text="BYTE OFFSET" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="3" Text="SIZE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="4" Text="DETAIL" Style="{StaticResource SectionTitle}"/>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="FindingList" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Padding="4,3"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="kind" Text="{Binding Kind}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Location}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StartText}" FontFamily="Cascadia Mono, Consolas"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Detail}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Unreadable}" Value="False">
                                        <Setter TargetName="kind" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ScanExportButton" Content="Export report" Style="{StaticResource SubtleButton}" Margin="0,0,10,0"
                        IsEnabled="False" Click="ScanExport_Click"/>
                <Button x:Name="ScanButton" Content="Start scan" Style="{StaticResource AccentButton}" Click="Scan_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= FORMAT PAGE ================= -->
        <Grid Grid.Row="2" x:Name="FormatPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DISK TO FORMAT · everything on it will be erased" Style="{StaticResource SectionTitle}"
                               Foreground="{StaticResource DangerBrush}"/>
                    <ComboBox x:Name="FormatDiskCombo" DisplayMemberPath="Caption" SelectionChanged="FormatDisk_Changed"/>
                    <TextBlock x:Name="FormatDiskInfo" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OPTIONS" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Partition table" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="FormatStyleCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="File system" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FormatFsCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Text="Label" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="FormatLabelBox" Width="220" HorizontalAlignment="Left" MaxLength="32"/>
                        </Grid>
                        <CheckBox x:Name="FormatFullCheck" Margin="0,10,0,0"
                                  Content="Full format - writes every sector (slow, hours on a big drive)"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,2,0,0"
                                   Text="Also makes an SSD replace sectors it can't read. Quick only rewrites the file system."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CONFIRM" Style="{StaticResource SectionTitle}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock x:Name="FormatConfirmHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Type the disk number to format."/>
                        <TextBox x:Name="FormatConfirmBox" MaxLength="3" Width="80" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <TextBox x:Name="FormatLogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="FormatButton" Content="Format disk" Style="{StaticResource DangerButton}" Click="Format_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= PARTITIONS PAGE (Disk Management-style) ================= -->
        <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="PartitionsPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,8">
                        <TextBlock Text="DISK LAYOUT · click a partition to resize it" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#FF3C78D8" Margin="0,0,6,0"/>
                            <TextBlock Text="Partition" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                            <Border Width="12" Height="12" CornerRadius="2" Background="#FF0A0A0A"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,6,0"/>
                            <TextBlock Text="Unallocated" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PartitionDisksPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SELECTED" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="PartTitle" Text="Nothing selected" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PartText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Like Disk Management: a partition can be shrunk, or extended into unallocated space directly after it."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" x:Name="PartResizePanel" IsEnabled="False">
                        <TextBlock Text="NEW SIZE" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="PartSizeBox" Width="110" MaxLength="10" TextChanged="PartSizeBox_TextChanged"
                                     AutomationProperties.Name="New size in GB"/>
                            <TextBlock Text="GB" VerticalAlignment="Center" Margin="8,0,16,0"/>
                            <Button x:Name="PartMinButton" Content="Smallest" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                    Click="PartMin_Click" ToolTip="Shrink as far as Windows allows"/>
                            <Button x:Name="PartMaxButton" Content="Largest" Style="{StaticResource SmallButton}"
                                    Click="PartMax_Click" ToolTip="Extend into all free space directly after it"/>
                        </StackPanel>
                        <Slider x:Name="PartSlider" Margin="0,10,0,0" ValueChanged="PartSlider_ValueChanged"
                                IsSnapToTickEnabled="False" AutomationProperties.Name="New size"/>
                        <TextBlock x:Name="PartRangeText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PartResizeButton" Content="Resize" Style="{StaticResource AccentButton}" IsEnabled="False"
                        Click="PartResize_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= PREFERENCES PAGE ================= -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" x:Name="PrefsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ACCENT COLOUR" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Used for buttons, selection, progress and the logo in this window. Default is white. The exe/taskbar icon stays white."/>
                            <ItemsControl x:Name="SwatchList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Swatch_Click" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}"
                                                Margin="0,0,10,10" Width="36" Height="36" Cursor="Hand"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                                                        <Border CornerRadius="7" Background="{Binding Brush}"
                                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Custom hex" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="AccentHexInput" Width="110" MaxLength="7" KeyDown="AccentHex_KeyDown"/>
                                <Button Content="Apply" Style="{StaticResource SubtleButton}" Margin="10,0,0,0" Click="ApplyAccent_Click"/>
                                <Button Content="Reset to white" Style="{StaticResource SubtleButton}" Margin="10,0,0,0" Click="ResetAccent_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AccentError" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- live preview -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="20" Margin="24,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Image x:Name="PreviewLogo" Width="96" Height="96" HorizontalAlignment="Center"/>
                                <Button Content="Start clone" Style="{StaticResource AccentButton}" Margin="0,14,0,0"/>
                                <ProgressBar Value="62" Margin="0,12,0,0" Width="150"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Shared progress / status bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Ready."/>
                <ProgressBar x:Name="Progress" Margin="0,6,0,0" Maximum="100"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Style="{StaticResource SubtleButton}"
                    Margin="16,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
        </Grid>
    </Grid>
    </Grid>
</Window>
